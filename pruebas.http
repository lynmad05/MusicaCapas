### 12 
GET {{host}}/api/albumes/1

### 13 
GET {{host}}/api/albumes/1
Authorization: Bearer {{loginOyente.response.body.$.token}}

### 14 
POST {{host}}/api/albumes
Content-Type: {{json}}
Authorization: Bearer {{loginOyente.response.body.$.token}}

{ "titulo": "Nevermind", "artista": "Nirvana", "genero": "Rock", "anioLanzamiento": 1991 }


### 15 
# @name crearAlbum
POST {{host}}/api/albumes
Content-Type: {{json}}
Authorization: Bearer {{loginCurador.response.body.$.token}}

{ "titulo": "Nevermind", "artista": "Nirvana", "genero": "Rock", "anioLanzamiento": 1991 }

### 16
PUT {{host}}/api/albumes/{{crearAlbum.response.body.$.id}}
Content-Type: {{json}}
Authorization: Bearer {{loginCurador.response.body.$.token}}

{ "titulo": "Nevermind", "artista": "Nirvana", "genero": "Grunge", "anioLanzamiento": 1991 }


### 17 
# @name crearCancion
POST {{host}}/api/canciones
Content-Type: {{json}}
Authorization: Bearer {{loginCurador.response.body.$.token}}

{
  "albumId": {{crearAlbum.response.body.$.id}},
  "titulo": "Smells Like Teen Spirit",
  "numeroPista": 1,
  "duracionSegundos": 301
}

### 18 
DELETE {{host}}/api/albumes/{{crearAlbum.response.body.$.id}}
Authorization: Bearer {{loginCurador.response.body.$.token}}

### 19 
DELETE {{host}}/api/canciones/{{crearCancion.response.body.$.id}}
Authorization: Bearer {{loginCurador.response.body.$.token}}

### 20
DELETE {{host}}/api/albumes/{{crearAlbum.response.body.$.id}}
Authorization: Bearer {{loginGerente.response.body.$.token}}

