}

### 19 
DELETE {{host}}/api/albumes/{{crearAlbum.response.body.$.id}}

### 20
DELETE {{host}}/api/canciones/{{crearCancion.response.body.$.id}}

### 21 
DELETE {{host}}/api/albumes/{{crearAlbum.response.body.$.id}}